    def analyse_customer(
        self,
        customer_details: dict,
        emi_history,
        valuation,
        settlement,
    ) -> str:
        """
        Generate the initial loan analysis.
        """
 
        prompt = f"""
Customer Details
 
{json.dumps(customer_details, indent=2, default=str)}
 
Vehicle Valuation
 
Market Value : {valuation.market_value}
 
Dealer Value : {valuation.dealer_value}
 
Auction Value : {valuation.auction_value}
 
Settlement Recommendation
 
LES : {settlement.les}
 
MID : {settlement.mid}
 
HES : {settlement.hes}
 
EMI History
 
{emi_history.to_string(index=False)}
 
Please provide:
 
1. Financial Assessment
2. Risk Assessment
3. Negotiation Strategy
4. Recommended Settlement
"""
 
        return azure_openai_service.chat(
            system_prompt=self.system_prompt,
            user_prompt=prompt,
        )
 
    def negotiate(
        self,
        customer_message: str,
        settlement,
        history,
        intent,
    ) -> str:
        """
        Continue negotiation with the customer.
        """
 
        prompt = f"""
Settlement Limits
 
LES : {settlement.les}
 
MID : {settlement.mid}
 
HES : {settlement.hes}
 
Customer says:
 
{customer_message}
 
Customer Intent: {intent}
 
Reply naturally as a loan settlement officer.
"""
 
        return azure_openai_service.chat(
            system_prompt=self.system_prompt,
            user_prompt=prompt,
        )
 
 
