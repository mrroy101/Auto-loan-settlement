"""
Approval Agent
 
Responsible for:
1. Approving or rejecting settlement offers.
2. Generating settlement letters.
"""
 
from pathlib import Path
from datetime import datetime
 
from reportlab.lib.units import inch
from reportlab.platypus import (
    Paragraph,
    SimpleDocTemplate,
    Spacer,
)
from reportlab.lib.styles import getSampleStyleSheet
 
 
class ApprovalAgent:
    """Approves settlement offers and generates PDF letters."""
 
    def __init__(self):
        self.report_folder = (
            Path(__file__).resolve().parent.parent
            / "reports"
        )
 
        self.report_folder.mkdir(
            exist_ok=True
        )
 
    def evaluate_offer(
        self,
        customer_name: str,
        customer_id: str,
        offer_amount: float,
        settlement,
    ):
        """
        Evaluate settlement offer.
 
        Returns:
            status, pdf_path
        """
 
        hes = settlement.hes
 
        if offer_amount >= hes:
            status = "APPROVED"
 
        elif offer_amount >= hes * 0.98:
            status = "PENDING RM APPROVAL"
 
        else:
            status = "REJECTED"
 
        pdf = self.generate_letter(
            customer_name,
            customer_id,
            offer_amount,
            status,
        )
 
        return status, pdf
 
    def generate_letter(
        self,
        customer_name: str,
        customer_id: str,
        offer_amount: float,
        status: str,
    ):
        """
        Generate settlement letter PDF.
        """
 
        filename = (
            f"{customer_id}_settlement_letter.pdf"
        )
 
        pdf_path = (
            self.report_folder
            / filename
        )
 
        doc = SimpleDocTemplate(
            str(pdf_path)
        )
 
        styles = getSampleStyleSheet()
 
        story = []
 
        story.append(
            Paragraph(
                "<b>Auto Loan Settlement Letter</b>",
                styles["Title"],
            )
        )
 
        story.append(
            Spacer(
                1,
                0.30 * inch,
            )
        )
 
        story.append(
            Paragraph(
                f"<b>Date:</b> {datetime.today().strftime('%d-%m-%Y')}",
                styles["Normal"],
            )
        )
 
        story.append(
            Paragraph(
                f"<b>Customer ID:</b> {customer_id}",
                styles["Normal"],
            )
        )
 
        story.append(
            Paragraph(
                f"<b>Customer Name:</b> {customer_name}",
                styles["Normal"],
            )
        )
 
        story.append(
            Paragraph(
                f"<b>Settlement Offer:</b> ₹{offer_amount:,.2f}",
                styles["Normal"],
            )
        )
 
        story.append(
            Paragraph(
                f"<b>Decision:</b> {status}",
                styles["Normal"],
            )
        )
 
        story.append(
            Spacer(
                1,
                0.30 * inch,
            )
        )
 
        if status == "APPROVED":
 
            message = (
                "Your settlement offer has been approved. "
                "Please complete the payment as per the agreed terms."
            )
 
        elif status == "PENDING RM APPROVAL":
 
            message = (
                "Your settlement offer requires "
                "Relationship Manager approval. "
                "You will be contacted shortly."
            )
 
        else:
 
            message = (
                "We regret to inform you that your settlement offer "
                "cannot be accepted at this time."
            )
 
        story.append(
            Paragraph(
                message,
                styles["BodyText"],
            )
        )
 
        story.append(
            Spacer(
                1,
                0.50 * inch,
            )
        )
 
        story.append(
            Paragraph(
                "Regards,<br/>Loan Settlement Team",
                styles["Normal"],
            )
        )
 
        doc.build(story)
 
        return pdf_path
 
 
approval_agent = ApprovalAgent()
