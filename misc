"""
Vehicle valuation service.
 
Provides a simple depreciation-based valuation.
Can later be replaced with an external API.
"""
 
from dataclasses import dataclass
from datetime import datetime
 
 
@dataclass
class VehicleValuation:
    market_value: float
    dealer_value: float
    auction_value: float
 
 
class VehicleService:
    """Calculates estimated vehicle values."""
 
    @staticmethod
    def estimate_value(
        brand: str,
        model: str,
        variant: str,
        manufacturing_year: int,
        original_price: float,
    ) -> VehicleValuation:
        """
        Estimate vehicle valuation using depreciation.
 
        Args:
            brand: Vehicle brand
            model: Vehicle model
            variant: Vehicle variant
            manufacturing_year: Manufacturing year
            original_price: Original ex-showroom/on-road price
 
        Returns:
            VehicleValuation
        """
 
        current_year = datetime.now().year
 
        age = max(0, current_year - manufacturing_year)
 
        if age == 0:
            depreciation = 0.10
        elif age == 1:
            depreciation = 0.20
        else:
            depreciation = 0.20 + ((age - 1) * 0.10)
 
        depreciation = min(depreciation, 0.80)
 
        market_value = original_price * (1 - depreciation)
 
        dealer_value = market_value * 0.95
 
        auction_value = market_value * 0.85
 
        return VehicleValuation(
            market_value=round(market_value, 2),
            dealer_value=round(dealer_value, 2),
            auction_value=round(auction_value, 2),
        )
