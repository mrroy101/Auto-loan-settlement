"""
Settlement calculation service.
"""
 
from dataclasses import dataclass
 
 
@dataclass
class SettlementRecommendation:
    total_outstanding: float
    les: float
    mid: float
    hes: float
 
 
class SettlementService:
    """Business rules for settlement calculations."""
 
    @staticmethod
    def calculate(
        outstanding_principal: float,
        outstanding_interest: float,
        auction_value: float,
    ) -> SettlementRecommendation:
        """
        Calculate settlement recommendation.
 
        Args:
            outstanding_principal: Remaining principal
            outstanding_interest: Outstanding interest
            auction_value: Estimated auction value of vehicle
 
        Returns:
            SettlementRecommendation
        """
 
        total_outstanding = (
            outstanding_principal +
            outstanding_interest
        )
 
        les = max(
            total_outstanding * 0.70,
            auction_value,
        )
 
        mid = total_outstanding * 0.85
 
        hes = total_outstanding * 0.95
 
        # Maintain order
        mid = max(mid, les)
        hes = max(hes, mid)
 
        return SettlementRecommendation(
            total_outstanding=round(total_outstanding, 2),
            les=round(les, 2),
            mid=round(mid, 2),
            hes=round(hes, 2),
        )
 
 
# Singleton instance
settlement_service = SettlementService()
 
